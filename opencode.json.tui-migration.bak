{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "provider": {
    "openrouter": {
      "npm": "@openrouter/ai-sdk-provider",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {
        "anthropic/claude-sonnet-4.5": { "name": "Claude Sonnet 4.5" },
        "anthropic/claude-opus-4.1": { "name": "Claude Opus 4.1" },
        "deepseek/deepseek-chat": { "name": "DeepSeek V3" },
        "deepseek/deepseek-coder": { "name": "DeepSeek Coder" },
        "deepseek/deepseek-r1": { "name": "DeepSeek R1" }
      }
    }
  },
  "model": "openrouter/anthropic/claude-sonnet-4.5",
  "small_model": "openrouter/deepseek/deepseek-chat",
  "autoshare": false,
  "autoupdate": true,
  "theme": "opencode"
}
